<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="en-US"><voice name="en-US-AndrewMultilingualNeural"><prosody rate="+12%" pitch="+0Hz" volume="+0%"><lang xml:lang="ca-ES">Amb </lang><lang xml:lang="en-US">GitHub</lang><lang xml:lang="ca-ES"> compartim el projecte. </lang><lang xml:lang="en-US">Git add</lang><lang xml:lang="ca-ES"> prepara els canvis i </lang><lang xml:lang="en-US">git commit</lang><lang xml:lang="ca-ES"> els desa. Creem la branca salutació des de </lang><lang xml:lang="en-US">main</lang><lang xml:lang="ca-ES">. Amb </lang><lang xml:lang="en-US">fetch</lang><lang xml:lang="ca-ES"> revisem les novetats abans de fer </lang><lang xml:lang="en-US">merge</lang><lang xml:lang="ca-ES"> o </lang><lang xml:lang="en-US">rebase</lang><lang xml:lang="ca-ES">. Els fitxers punt </lang><lang xml:lang="en-US">log</lang><lang xml:lang="ca-ES"> guarden informació. Amb </lang><lang xml:lang="en-US">git log</lang><lang xml:lang="ca-ES"> consultem l&#x27;historial. La correcció queda desada.</lang></prosody></voice></speak>
