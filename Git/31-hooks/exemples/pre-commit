#!/usr/bin/env python3
import subprocess
import sys

contingut = subprocess.run(
    ["git", "show", ":helloGit.py"],
    capture_output=True, text=True, check=True,
).stdout
try:
    compile(contingut, "helloGit.py", "exec")
except SyntaxError as error:
    print(f"pre-commit: error de sintaxi a helloGit.py, línia {error.lineno}: {error.msg}")
    sys.exit(1)
