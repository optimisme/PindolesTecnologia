    <lang xml:lang="en-US"><prosody rate="+0%">git add</prosody></lang>
    <break time="500ms" />
    <lang xml:lang="ca-ES"><prosody rate="+8%"> preparem els canvis. Després, </prosody></lang>
    <break time="500ms" />
    <lang xml:lang="en-US"><prosody rate="+0%">git commit</prosody></lang>
    <break time="500ms" />
    <lang xml:lang="ca-ES"><prosody rate="+8%"> desa una versió del projecte. Consultem l’historial amb </prosody></lang>
    <break time="500ms" />
    <lang xml:lang="en-US"><prosody rate="+0%">git log</prosody></lang>
    <break time="500ms" />
    <lang xml:lang="ca-ES"><prosody rate="+8%">. Per compartir la correcció, fem </prosody></lang>
