    <lang xml:lang="en-US"><prosody rate="+0%">git push</prosody></lang>
    <break time="500ms" />
    <lang xml:lang="ca-ES"><prosody rate="+8%"> i enviem els canvis a </prosody></lang>
    <break time="500ms" />
    <lang xml:lang="en-US"><prosody rate="+0%">GitHub</prosody></lang>
